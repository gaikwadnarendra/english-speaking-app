{
  "expo": {
    "name": "English शिका (Marathi to English)",
    "slug": "marathi-english-learning",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E1B4B"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "English शिका uses the microphone to evaluate your spoken English pronunciation and improve your speaking skills.",
        "NSSpeechRecognitionUsageDescription": "English शिका uses speech recognition to help you practice English speaking."
      }
    },
    "android": {
      "package": "com.englishshika.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E1B4B"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "9d56e533-40dc-4ad6-92a6-2f415d5da517"
      }
    },
    "plugins": [
      "expo-speech-recognition"
    ]
  }
}
